<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Home - Student Management System</title>
    <meta name="description" content="Lightweight SSR Student Management with Node.js + Express + EJS + JSON storage">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="/css/app.css" rel="stylesheet">
</head>
<body class="d-flex flex-column min-vh-100">

<nav class="navbar navbar-expand-lg navbar-dark navbar-portal sticky-top">
    <div class="container">
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="/">
            <span class="brand-mark"><i class="bi bi-mortarboard-fill"></i></span>
            <span>Student Portal <span class="badge bg-warning text-dark ms-1" style="font-size:.65rem">TEAM 13</span></span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                <li class="nav-item">
                    <a class="nav-link nav-link-portal active" href="/"><i class="bi bi-house-door me-1"></i>Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link nav-link-portal" href="/students"><i class="bi bi-people me-1"></i>Students Directory</a>
                </li>
                <li class="nav-item ms-lg-2">
                    <a href="/students" class="btn btn-warning btn-sm fw-bold px-3 py-2 btn-shine rounded-pill">
                        <i class="bi bi-lightning-charge-fill me-1"></i>Open App
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="container my-4 my-md-5 flex-grow-1">

    <!-- Hero -->
    <div class="hero-portal p-4 p-md-5 mb-4">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
        <div class="hero-inner text-center py-3 py-md-4 px-2">
            <span class="hero-badge mb-3">
                <span class="dot"><i class="bi bi-check"></i></span>
                Node.js &bull; Express SSR &bull; Zero-DB JSON
            </span>
            <h1 class="hero-title display-4 fw-bold text-white mb-3">
                Student Management,<br class="d-none d-md-block">
                <span class="grad">beautifully simple.</span>
            </h1>
            <p class="hero-sub lead col-lg-8 mx-auto mb-4">
                A lightweight server-rendered portal for adding, listing, and deleting student records with JSON persistence,
                instant validation, and PRG-safe forms. No database, no ORM &mdash; strictly Add, List, and Delete.
            </p>
            <div class="d-flex flex-column flex-sm-row gap-2 justify-content-center mb-4">
                <a href="/students" class="btn btn-warning btn-lg px-4 fw-bold text-dark shadow btn-shine rounded-pill">
                    <i class="bi bi-people-fill me-2"></i>View Students Directory
                </a>
                <a href="#features" class="btn btn-outline-light btn-lg px-4 rounded-pill fw-semibold">
                    Explore features
                </a>
            </div>
            <div class="hero-stats row g-2 col-lg-9 mx-auto text-start">
                <div class="col-4">
                    <div class="hero-stat p-3 text-center">
                        <div class="fs-4 fw-bold text-white count-up" data-count-to="100">0</div>
                        <div class="small text-white-50">% SSR rendered</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="hero-stat p-3 text-center">
                        <div class="fs-4 fw-bold text-white"><span class="count-up" data-count-to="0">0</span> DB</div>
                        <div class="small text-white-50">JSON file only</div>
                    </div>
                </div>
                <div class="col-4">
                    <div class="hero-stat p-3 text-center">
                        <div class="fs-4 fw-bold text-white"><span class="count-up" data-count-to="3">0</span> devs</div>
                        <div class="small text-white-50">Team 13 &bull; HCMUS</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Features -->
    <div id="features" class="row g-4 mb-4">
        <div class="col-md-4 reveal" style="--d:.05s">
            <div class="card feature-card h-100 p-2" data-tilt style="--accent-grad:linear-gradient(90deg,#3b82f6,#8b5cf6)">
                <div class="card-body">
                    <div class="icon-tile icon-blue mb-3"><i class="bi bi-cpu"></i></div>
                    <h5 class="card-title fw-bold">SSR &amp; EJS</h5>
                    <p class="card-text text-muted mb-3">
                        Rendered on the server for fast first paint, SEO and form binding with instant error feedback.
                    </p>
                    <span class="small fw-semibold text-primary">Express + EJS + Bootstrap 5 <i class="bi bi-arrow-right ms-1"></i></span>
                </div>
            </div>
        </div>
        <div class="col-md-4 reveal" style="--d:.15s">
            <div class="card feature-card h-100 p-2" data-tilt style="--accent-grad:linear-gradient(90deg,#22c55e,#0ea5e9)">
                <div class="card-body">
                    <div class="icon-tile icon-green mb-3"><i class="bi bi-filetype-json"></i></div>
                    <h5 class="card-title fw-bold">JSON File Storage</h5>
                    <p class="card-text text-muted mb-3">
                        Self-contained persistence in <code>data/students.json</code> with a mutex and atomic file swaps.
                    </p>
                    <span class="small fw-semibold text-success">Safe writes &bull; Zero-DB <i class="bi bi-arrow-right ms-1"></i></span>
                </div>
            </div>
        </div>
        <div class="col-md-4 reveal" style="--d:.25s">
            <div class="card feature-card h-100 p-2" data-tilt style="--accent-grad:linear-gradient(90deg,#f43f5e,#f59e0b)">
                <div class="card-body">
                    <div class="icon-tile icon-rose mb-3"><i class="bi bi-shield-check"></i></div>
                    <h5 class="card-title fw-bold">Validation &amp; Deletion</h5>
                    <p class="card-text text-muted mb-3">
                        Required-field, 8-digit ID and major checks, duplicate prevention, and one-click deletion with confirmation dialogs.
                    </p>
                    <span class="small fw-semibold text-danger">Server validation &bull; Add, List, Delete <i class="bi bi-arrow-right ms-1"></i></span>
                </div>
            </div>
        </div>
    </div>

    <!-- How it works strip -->
    <div class="card card-lift border-0 mb-4 reveal" style="--d:.1s">
        <div class="card-body p-4">
            <div class="row g-3 align-items-center">
                <div class="col-md-8">
                    <h6 class="fw-bold mb-2"><i class="bi bi-diagram-3 me-2 text-primary"></i>How it works</h6>
                    <div class="d-flex flex-wrap align-items-center gap-2 small">
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><span class="fw-bold text-primary me-1">1</span> GET /students</span>
                        <i class="bi bi-arrow-right text-muted"></i>
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><span class="fw-bold text-primary me-1">2</span> Fill modal form</span>
                        <i class="bi bi-arrow-right text-muted"></i>
                        <span class="badge bg-light text-dark border px-3 py-2 rounded-pill"><span class="fw-bold text-primary me-1">3</span> POST + validate</span>
                        <i class="bi bi-arrow-right text-muted"></i>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill"><i class="bi bi-check-circle me-1"></i>PRG redirect</span>
                    </div>
                </div>
                <div class="col-md-4 text-md-end">
                    <a href="/students" class="btn btn-primary rounded-pill px-4 fw-semibold btn-shine">
                        Try it now <i class="bi bi-arrow-right-short"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Team -->
    <div class="card card-lift border-0 reveal" style="--d:.15s">
        <div class="card-header bg-transparent border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold"><i class="bi bi-people-fill me-2 text-primary"></i>Development Team</h5>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3">3 members</span>
        </div>
        <div class="card-body px-4 pb-4">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th style="width: 25%">Student ID</th>
                        <th style="width: 45%">Full Name</th>
                        <th style="width: 30%">Role</th>
                    </tr>
                    </thead>
                    <tbody class="stagger">
                    <tr style="--i:0">
                        <td><span class="badge bg-dark font-monospace rounded-pill px-3">24127052</span></td>
                        <td>
                            <span class="d-flex align-items-center gap-2">
                                <span class="avatar avatar-0">K</span>
                                <span class="fw-semibold">Phùng Bảo Khang</span>
                            </span>
                        </td>
                        <td class="text-muted">Team Member</td>
                    </tr>
                    <tr style="--i:1">
                        <td><span class="badge bg-dark font-monospace rounded-pill px-3">24127345</span></td>
                        <td>
                            <span class="d-flex align-items-center gap-2">
                                <span class="avatar avatar-1">Đ</span>
                                <span class="fw-semibold">Nguyễn Minh Đức</span>
                            </span>
                        </td>
                        <td class="text-muted">Team Member</td>
                    </tr>
                    <tr style="--i:2">
                        <td><span class="badge bg-dark font-monospace rounded-pill px-3">24127388</span></td>
                        <td>
                            <span class="d-flex align-items-center gap-2">
                                <span class="avatar avatar-2">H</span>
                                <span class="fw-semibold">Hy Huê Hưng</span>
                            </span>
                        </td>
                        <td class="text-muted">Team Member</td>
                    </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</main>

<footer class="footer-portal border-top py-4 mt-auto">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 text-muted small">
        <span>&copy; 2026 Student Management System &bull; Team 13 &bull; HCMUS</span>
        <span><i class="bi bi-lightning-charge-fill text-warning me-1"></i>Node.js &amp; Express SSR &bull; Bootstrap 5</span>
    </div>
</footer>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
<script src="/js/app.js"></script>
</body>
</html>
